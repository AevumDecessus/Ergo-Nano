(rules PCB ergonano
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 6)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.5)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.5)
    )
  )
  (rule
    (width 150.0)
    (clearance 200.0)
    (clearance 150.0 (type smd_smd))
    (clearance 75.0 (type smd_to_turn_gap))
    (clearance 75.0 (type pad_to_turn_gap))
    (clearance 200.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
    (clearance 200.0 (type "power_ground"))
  )
  (padstack "Via[0-1]_560:300_um"
    (shape
      (circle F.Cu 560.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 560.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_560:300_um" "Via[0-1]_560:300_um" default
  )
  (via 
    "Via[0-1]_560:300_um-kicad_default" "Via[0-1]_560:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_560:300_um-power_ground" "Via[0-1]_560:300_um" "power_ground"
  )
  (via_rule
    default "Via[0-1]_560:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_560:300_um-kicad_default"
  )
  (via_rule
    "power_ground" "Via[0-1]_560:300_um-power_ground"
  )
  (class default
    (via_rule default)
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    C0 "outer_mod" "outer_bottom" "outer_home" "outer_top" "outer_num"
    C1 "pinky_mod" "pinky_bottom" "pinky_home" "pinky_top" "pinky_num"
    C2 "ring_mod" "ring_bottom" "ring_home" "ring_top" "ring_num"
    C3 "middle_mod" "middle_bottom" "middle_home" "middle_top" "middle_num"
    C4 "index_mod" "index_bottom" "index_home" "index_top" "index_num"
    C5 "inner_bottom" "inner_home" "inner_top" "inner_num"
    C6 "innermod_bottom" "innermod_home" "innermod_top" "innermod_num" "encoder_encoder"
    C7 "t_col0_near" "t_col1_near" "t_col1_far" "t_col2_near" "t_col2_far"
    R0 R1 R2 R3 R4 RS
    CS MOS SCK E1 E2 P0 P4 "J_LED" "J_MFET_GATE" "LED_MFET_GATE"
    "LED_0" "LED_1" "LED_2" "LED_3" "LED_4" "LED_5" "LED_6" "LED_7" "LED_8" "LED_9"
    "LED_10" "LED_11" "LED_12" "LED_13" "LED_14" "LED_15" "LED_16" "LED_17" "LED_18" "LED_19"
    "LED_20" "LED_21" "LED_22" "LED_23" "LED_24" "LED_25" "LED_26" "LED_27" "LED_28" "LED_29"
    "LED_30" "LED_31" "LED_32" "LED_33" "LED_34" "LED_35" "LED_36" "LED_37"
    "ULED_1" "ULED_2" "ULED_3" "ULED_4" "ULED_5" "ULED_6" "ULED_7" "ULED_8" "ULED_9" "ULED_10"
    (via_rule "kicad_default")
    (rule
      (width 150.0)
      (clearance 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "power_ground"
    RAW GND VCC "LED_VCC" "BAT_P" "JST1_1" "JST1_2"
    (via_rule "kicad_default")
    (rule
      (width 250.0)
      (clearance 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)